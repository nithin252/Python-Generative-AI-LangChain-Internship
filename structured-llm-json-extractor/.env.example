# Datheon Internship Task 1: Environment Variables
# Copy this file to .env and insert your real Gemini API key
# Windows PowerShell: Copy-Item .env.example .env
# Linux/macOS:        cp .env.example .env

# Google Gemini API key (Obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Configurable Gemini model alias or full model name
# Examples: gemini-2.5-flash (fast & accurate), gemini-2.5-pro (complex extraction), gemini-3.8-flash
GEMINI_MODEL="gemini-2.5-flash"

# Default LLM provider: "gemini" or "mock" (for offline local development)
LLM_PROVIDER="gemini"

# Retry count for transient network/rate limit issues (max 5)
MAX_RETRIES=3

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30
